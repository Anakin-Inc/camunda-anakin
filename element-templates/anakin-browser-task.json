{
  "$schema" : "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name" : "Anakin - Browser Task",
  "id" : "io.anakin.connector.BrowserTask.v1",
  "description" : "Run a natural-language task in a real AI-driven cloud browser with Anakin (https://anakin.io). Transparently polls to completion.",
  "metadata" : {
    "keywords" : [ ]
  },
  "documentationRef" : "https://anakin.io/docs",
  "version" : 1,
  "category" : {
    "id" : "connectors",
    "name" : "Connectors"
  },
  "appliesTo" : [ "bpmn:Task" ],
  "elementType" : {
    "value" : "bpmn:ServiceTask"
  },
  "engines" : {
    "camunda" : "^8.9"
  },
  "groups" : [ {
    "id" : "authentication",
    "label" : "Authentication"
  }, {
    "id" : "input",
    "label" : "Task input"
  }, {
    "id" : "connector",
    "label" : "Connector"
  }, {
    "id" : "output",
    "label" : "Output mapping"
  }, {
    "id" : "error",
    "label" : "Error handling"
  }, {
    "id" : "retries",
    "label" : "Retries"
  } ],
  "properties" : [ {
    "value" : "io.anakin:browser-task:1",
    "binding" : {
      "property" : "type",
      "type" : "zeebe:taskDefinition"
    },
    "type" : "Hidden"
  }, {
    "id" : "apiKey",
    "label" : "Anakin API Key",
    "description" : "Paste a secret reference, e.g. <code>{{secrets.ANAKIN_API_KEY}}</code>, rather than a raw key. Get a free key (300 credits, no card required) at anakin.io/dashboard.",
    "optional" : false,
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "authentication",
    "binding" : {
      "name" : "apiKey",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "prompt",
    "label" : "Prompt",
    "description" : "The task in natural language. Be specific about the goal and what to return. Never include passwords or secrets -- use Session ID for authenticated sites.",
    "optional" : false,
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "input",
    "binding" : {
      "name" : "prompt",
      "type" : "zeebe:input"
    },
    "type" : "Text"
  }, {
    "id" : "url",
    "label" : "URL",
    "description" : "Navigate here before starting. Leave empty to let the agent follow URLs named in the prompt.",
    "optional" : true,
    "feel" : "optional",
    "group" : "input",
    "binding" : {
      "name" : "url",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "sessionId",
    "label" : "Session ID",
    "description" : "Saved browser-session ID (from Session List) so the task runs logged in.",
    "optional" : true,
    "feel" : "optional",
    "group" : "input",
    "binding" : {
      "name" : "sessionId",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "maxSteps",
    "label" : "Max Steps",
    "description" : "Cap on agent steps (navigation/click/type actions).",
    "optional" : true,
    "feel" : "static",
    "group" : "input",
    "binding" : {
      "name" : "maxSteps",
      "type" : "zeebe:input"
    },
    "type" : "Number"
  }, {
    "id" : "timeoutMs",
    "label" : "Timeout (ms)",
    "description" : "Task timeout in milliseconds (server caps runs at ~330s regardless).",
    "optional" : true,
    "feel" : "static",
    "group" : "input",
    "binding" : {
      "name" : "timeoutMs",
      "type" : "zeebe:input"
    },
    "type" : "Number"
  }, {
    "id" : "outputSchema",
    "label" : "Output Schema (JSON Schema)",
    "description" : "JSON Schema for the result -- the agent returns structured data conforming to it. FEEL context expression.",
    "optional" : true,
    "feel" : "optional",
    "group" : "input",
    "binding" : {
      "name" : "outputSchema",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "version",
    "label" : "Version",
    "description" : "Version of the element template",
    "value" : "1",
    "group" : "connector",
    "binding" : {
      "key" : "elementTemplateVersion",
      "type" : "zeebe:taskHeader"
    },
    "type" : "Hidden"
  }, {
    "id" : "id",
    "label" : "ID",
    "description" : "ID of the element template",
    "value" : "io.anakin.connector.BrowserTask.v1",
    "group" : "connector",
    "binding" : {
      "key" : "elementTemplateId",
      "type" : "zeebe:taskHeader"
    },
    "type" : "Hidden"
  }, {
    "id" : "resultVariable",
    "label" : "Result variable",
    "description" : "Name of variable to store the response in",
    "group" : "output",
    "binding" : {
      "key" : "resultVariable",
      "type" : "zeebe:taskHeader"
    },
    "type" : "String"
  }, {
    "id" : "resultExpression",
    "label" : "Result expression",
    "description" : "Expression to map the response into process variables",
    "feel" : "required",
    "group" : "output",
    "binding" : {
      "key" : "resultExpression",
      "type" : "zeebe:taskHeader"
    },
    "type" : "Text"
  }, {
    "id" : "errorExpression",
    "label" : "Error expression",
    "description" : "Expression to handle errors. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/\" target=\"_blank\">documentation</a>.",
    "feel" : "required",
    "group" : "error",
    "binding" : {
      "key" : "errorExpression",
      "type" : "zeebe:taskHeader"
    },
    "type" : "Text"
  }, {
    "id" : "retryCount",
    "label" : "Retries",
    "description" : "Number of retries",
    "value" : "3",
    "feel" : "optional",
    "group" : "retries",
    "binding" : {
      "property" : "retries",
      "type" : "zeebe:taskDefinition"
    },
    "type" : "String"
  }, {
    "id" : "retryBackoff",
    "label" : "Retry backoff",
    "description" : "ISO-8601 duration to wait between retries",
    "value" : "PT0S",
    "group" : "retries",
    "binding" : {
      "key" : "retryBackoff",
      "type" : "zeebe:taskHeader"
    },
    "type" : "String"
  } ],
  "icon" : {
    "contents" : "data:image/svg+xml;base64,"
  }
