{
  "$schema" : "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name" : "Anakin - Scrape URL",
  "id" : "io.anakin.connector.UrlScraper.v1",
  "description" : "Scrape a single URL with Anakin (https://anakin.io) -- markdown/HTML/JSON extraction, optional real-browser rendering for JS-heavy or anti-bot sites.",
  "metadata" : {
    "keywords" : [ ]
  },
  "documentationRef" : "https://anakin.io/docs",
  "version" : 1,
  "category" : {
    "id" : "connectors",
    "name" : "Connectors"
  },
  "appliesTo" : [ "bpmn:Task" ],
  "elementType" : {
    "value" : "bpmn:ServiceTask"
  },
  "engines" : {
    "camunda" : "^8.9"
  },
  "groups" : [ {
    "id" : "authentication",
    "label" : "Authentication"
  }, {
    "id" : "input",
    "label" : "Scrape input"
  }, {
    "id" : "session",
    "label" : "Browser session (optional)"
  }, {
    "id" : "connector",
    "label" : "Connector"
  }, {
    "id" : "output",
    "label" : "Output mapping"
  }, {
    "id" : "error",
    "label" : "Error handling"
  }, {
    "id" : "retries",
    "label" : "Retries"
  } ],
  "properties" : [ {
    "value" : "io.anakin:url-scraper:1",
    "binding" : {
      "property" : "type",
      "type" : "zeebe:taskDefinition"
    },
    "type" : "Hidden"
  }, {
    "id" : "apiKey",
    "label" : "Anakin API Key",
    "description" : "Paste a secret reference, e.g. <code>{{secrets.ANAKIN_API_KEY}}</code>, rather than a raw key. Get a free key (300 credits, no card required) at anakin.io/dashboard.",
    "optional" : false,
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "authentication",
    "binding" : {
      "name" : "apiKey",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "url",
    "label" : "URL",
    "description" : "The page to scrape, including scheme (https://...).",
    "optional" : false,
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "input",
    "binding" : {
      "name" : "url",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "formats",
    "label" : "Formats",
    "description" : "Content formats to extract: markdown, html, cleanedHtml, json, links, images, screenshot, screenshotFullPage, summary. FEEL list expression, e.g. <code>=[\"markdown\",\"html\"]</code>. Defaults to just markdown.",
    "optional" : true,
    "feel" : "optional",
    "group" : "input",
    "binding" : {
      "name" : "formats",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "country",
    "label" : "Country",
    "description" : "Two-letter proxy exit country code, e.g. \"us\", \"gb\", \"de\".",
    "optional" : true,
    "value" : "us",
    "feel" : "optional",
    "group" : "input",
    "binding" : {
      "name" : "country",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "useBrowser",
    "label" : "Use Browser",
    "description" : "Render the page in a real browser first -- for JS-heavy or anti-bot sites. Slower and costs more credits than a plain fetch.",
    "optional" : true,
    "value" : false,
    "feel" : "static",
    "group" : "input",
    "binding" : {
      "name" : "useBrowser",
      "type" : "zeebe:input"
    },
    "type" : "Boolean"
  }, {
    "id" : "generateJson",
    "label" : "Generate JSON",
    "description" : "Also ask Anakin for an AI-structured JSON extraction of the page content.",
    "optional" : true,
    "value" : false,
    "feel" : "static",
    "group" : "input",
    "binding" : {
      "name" : "generateJson",
      "type" : "zeebe:input"
    },
    "type" : "Boolean"
  }, {
    "id" : "forceFresh",
    "label" : "Force Fresh",
    "description" : "Bypass the cache and re-scrape even if a recent cached result exists.",
    "optional" : true,
    "value" : false,
    "feel" : "static",
    "group" : "input",
    "binding" : {
      "name" : "forceFresh",
      "type" : "zeebe:input"
    },
    "type" : "Boolean"
  }, {
    "id" : "sessionId",
    "label" : "Session ID",
    "description" : "Reuse an existing saved browser session (cookies/login) by ID. Optional.",
    "optional" : true,
    "feel" : "optional",
    "group" : "session",
    "binding" : {
      "name" : "sessionId",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "sessionName",
    "label" : "Session Name",
    "description" : "Reuse an existing saved browser session (cookies/login) by name. Optional.",
    "optional" : true,
    "feel" : "optional",
    "group" : "session",
    "binding" : {
      "name" : "sessionName",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "version",
    "label" : "Version",
    "description" : "Version of the element template",
    "value" : "1",
    "group" : "connector",
    "binding" : {
      "key" : "elementTemplateVersion",
      "type" : "zeebe:taskHeader"
    },
    "type" : "Hidden"
  }, {
    "id" : "id",
    "label" : "ID",
    "description" : "ID of the element template",
    "value" : "io.anakin.connector.UrlScraper.v1",
    "group" : "connector",
    "binding" : {
      "key" : "elementTemplateId",
      "type" : "zeebe:taskHeader"
    },
    "type" : "Hidden"
  }, {
    "id" : "resultVariable",
    "label" : "Result variable",
    "description" : "Name of variable to store the response in",
    "group" : "output",
    "binding" : {
      "key" : "resultVariable",
      "type" : "zeebe:taskHeader"
    },
    "type" : "String"
  }, {
    "id" : "resultExpression",
    "label" : "Result expression",
    "description" : "Expression to map the response into process variables",
    "feel" : "required",
    "group" : "output",
    "binding" : {
      "key" : "resultExpression",
      "type" : "zeebe:taskHeader"
    },
    "type" : "Text"
  }, {
    "id" : "errorExpression",
    "label" : "Error expression",
    "description" : "Expression to handle errors. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/\" target=\"_blank\">documentation</a>.",
    "feel" : "required",
    "group" : "error",
    "binding" : {
      "key" : "errorExpression",
      "type" : "zeebe:taskHeader"
    },
    "type" : "Text"
  }, {
    "id" : "retryCount",
    "label" : "Retries",
    "description" : "Number of retries",
    "value" : "3",
    "feel" : "optional",
    "group" : "retries",
    "binding" : {
      "property" : "retries",
      "type" : "zeebe:taskDefinition"
    },
    "type" : "String"
  }, {
    "id" : "retryBackoff",
    "label" : "Retry backoff",
    "description" : "ISO-8601 duration to wait between retries",
    "value" : "PT0S",
    "group" : "retries",
    "binding" : {
      "key" : "retryBackoff",
      "type" : "zeebe:taskHeader"
    },
    "type" : "String"
  } ],
  "icon" : {
    "contents" : "data:image/svg+xml;base64,"
  }
}